# ── StaffRail Admin — environment variables ─────────────────────────────
# Copy this file to `.env.local` (development) or `.env.production`
# (deployment) and fill in the real values. NEVER commit real credentials.
#
#   cp .env.example .env.local
#
# All NEXT_PUBLIC_* values are safe for the browser: they are the standard
# public Firebase web-app identifiers (equivalent to what ships in the
# Flutter app's google-services.json / firebase_options.dart).
# ────────────────────────────────────────────────────────────────────────

# ── 1. Firebase web (browser) configuration — required ──────────────────
# Source: Firebase Console → Project settings → Your apps → Web app, or
# lib/core/config/firebase_options.dart in the repo root (web entry).

# Firebase web API key (public identifier, not a secret)
NEXT_PUBLIC_FIREBASE_API_KEY=

# Auth domain, format: <project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Cloud Firestore project id, format: <project-id>
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Cloud Storage bucket, format: <project-id>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase Cloud Messaging sender id, format: <project-number>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase web app id, format: <project-number>:web:<hash>
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── 2. Firebase Admin SDK (server-only) — required for login/session ────
# These values are ONLY used inside server code and are never exposed to
# the browser. Get them from a service account:
#   Firebase Console → Project settings → Service accounts
#   → Generate new private key (the key file values go here).
#
# Option A (recommended): a single JSON block of the service account file.
# Multi-line JSON must be one string (tip: base64-encode it or keep \n):
# FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":...}'
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# Option B: individual fields from the service-account JSON
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# The private key's newlines must be literal \n when passed as an env var.
FIREBASE_ADMIN_PRIVATE_KEY=

# ── 3. Session / CSRF secrets (server-only) ─────────────────────────────
# Random 32+ byte hex string used to sign CSRF double-submit cookies.
# Generate with:  openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
STAFFRAIL_CSRF_SECRET=

# Set to true in production to only accept https:// origins (defaults to
# https in production and http in development automatically).
STAFFRAIL_REQUIRE_HTTPS_ORIGIN=
