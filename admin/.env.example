# ── StaffRail Web Portal — Optional Environment Variables ───────────────
# StaffRail runs database-free out of the box with `npm install && npm run dev`
# using an in-memory seeded demo store. No variables below are required for
# local development or demo usage.
#
# For custom deployments, copy this file to `.env.local` and adjust as needed.
# ────────────────────────────────────────────────────────────────────────

# ── 1. Session & CSRF Signing Secrets (optional in dev; recommended in prod)
# Generate random 32+ byte hex strings with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STAFFRAIL_SESSION_SECRET=
STAFFRAIL_CSRF_SECRET=

# Set to true to enforce explicit secrets and disallow ephemeral dev secrets:
STAFFRAIL_REQUIRE_EXPLICIT_SECRET=false

# Set to true in production behind HTTPS to require https:// origins:
STAFFRAIL_REQUIRE_HTTPS_ORIGIN=false

# ── 2. Organization Branding (optional overrides) ────────────────────────
NEXT_PUBLIC_ORG_NAME=Example Health Clinic, LLC
NEXT_PUBLIC_ORG_SHORT_NAME=StaffRail
NEXT_PUBLIC_ORG_ADDRESS=100 Main Street, Suite 200 · Anytown, USA 00000
NEXT_PUBLIC_ORG_SUPPORT_EMAIL=support@staffrail.local
NEXT_PUBLIC_ORG_SUPPORT_PHONE=+1 (800) 555-0199
NEXT_PUBLIC_ORG_DIRECTOR_NAME=Clinic Director
